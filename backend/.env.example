# Copy this file to ".env" and fill in your real values.

# MongoDB connection strings (two separate clusters/databases)
MONGO_URI_PROPERTIES='mongodb+srv://<user>:<password>@<cluster>/<dbname>'
MONGO_URI_USERS='mongodb+srv://<user>:<password>@<cluster>/<dbname>'

# JWT auth
JWT_SECRET='replace-with-a-long-random-secret'
JWT_EXPIRES_IN='7d'

# Server
PORT=5000
